# Custodian-only Linux environment. No database URL, HMAC secret or private signing key.
# Protect this file (0600); keep it outside database/runtime backup custody.
LMS_PUBLICATION_DIRECTORY=/absolute/private/custodian/checkpoint-store
LMS_RECOVERY_TRUST_FILE=/absolute/private/custodian/prior-trust.json
LMS_PUBLICATION_CANDIDATE_FILE=/absolute/private/custodian/signed-journal.json
# Leave empty ONLY for the first init; retain the returned root digest independently.
LMS_PUBLICATION_ROOT_DIGEST=
