{
  "schemaVersion": 1,
  "id": "property-starter",
  "name": "Cedar Grove Property",
  "industry": "property",
  "modules": [
    {
      "id": "customers",
      "version": "1.0.0"
    },
    {
      "id": "tasks",
      "version": "1.0.0"
    },
    {
      "id": "property",
      "version": "1.0.0"
    },
    {
      "id": "inventory",
      "version": "1.0.0"
    }
  ],
  "entities": [
    {
      "id": "customers",
      "module": "customers",
      "singular": "Customer",
      "plural": "Customers",
      "titleField": "name",
      "fields": [
        {
          "key": "name",
          "label": "Name",
          "type": "text",
          "required": true
        },
        {
          "key": "email",
          "label": "Email",
          "type": "email",
          "required": false
        },
        {
          "key": "phone",
          "label": "Phone",
          "type": "text",
          "required": false
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "longtext",
          "required": false
        }
      ]
    },
    {
      "id": "tasks",
      "module": "tasks",
      "singular": "Task",
      "plural": "Tasks",
      "titleField": "title",
      "fields": [
        {
          "key": "title",
          "label": "Task title",
          "type": "text",
          "required": true
        },
        {
          "key": "status",
          "label": "Status",
          "type": "select",
          "required": true,
          "options": [
            "Open",
            "In progress",
            "Done"
          ]
        },
        {
          "key": "due",
          "label": "Due date",
          "type": "date",
          "required": false
        },
        {
          "key": "notes",
          "label": "Notes",
          "type": "longtext",
          "required": false
        }
      ]
    },
    {
      "id": "items",
      "module": "inventory",
      "singular": "Supply item",
      "plural": "Supply catalog",
      "titleField": "name",
      "fields": [
        {
          "key": "name",
          "label": "Item name",
          "type": "text",
          "required": true
        },
        {
          "key": "unit",
          "label": "Unit / package",
          "type": "text",
          "required": false
        },
        {
          "key": "notes",
          "label": "Reorder notes",
          "type": "longtext",
          "required": false
        }
      ]
    },
    {
      "id": "units",
      "module": "property",
      "singular": "Site or unit",
      "plural": "Sites & units",
      "titleField": "label",
      "fields": [
        {
          "key": "label",
          "label": "Site / unit label",
          "type": "text",
          "required": true
        },
        {
          "key": "kind",
          "label": "Unit type",
          "type": "select",
          "required": true,
          "options": [
            "RV site",
            "Apartment",
            "Cabin"
          ]
        },
        {
          "key": "condition",
          "label": "Physical condition",
          "type": "select",
          "required": true,
          "options": [
            "Ready",
            "Needs preparation",
            "Out of service"
          ]
        },
        {
          "key": "notes",
          "label": "Maintenance notes",
          "type": "longtext",
          "required": false
        }
      ]
    }
  ],
  "navigation": [
    "customers",
    "units",
    "tasks",
    "items"
  ]
}
