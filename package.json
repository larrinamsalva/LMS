{
  "name": "@lms/foundation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "check": "npm run typecheck && npm test && npm run licenses:check && npm run build",
    "db:init": "node --env-file=.env.postgres --import=tsx scripts/postgres.ts init",
    "db:migrate": "node --env-file=.env.postgres --import=tsx scripts/postgres.ts migrate",
    "db:backup": "node --env-file=.env.postgres --import=tsx scripts/postgres.ts backup",
    "db:restore": "node --env-file=.env.postgres --import=tsx scripts/postgres.ts restore",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "auth:init": "node --env-file=.env.postgres --env-file=.env.local-auth --import=tsx scripts/local-auth.ts init",
    "auth:provision": "node --env-file=.env.postgres --env-file=.env.local-auth --import=tsx scripts/local-auth.ts provision",
    "auth:revoke-all": "node --env-file=.env.postgres --env-file=.env.local-auth --import=tsx scripts/local-auth.ts revoke-all"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.14",
    "better-auth": "1.7.14",
    "kysely": "0.29.7",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
